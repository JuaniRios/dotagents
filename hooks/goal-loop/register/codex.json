{
  "description": "Shared goal-loop Stop hook from ~/Github/dotagents.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Github/dotagents/hooks/goal-loop/check-goal.sh",
            "timeout": 30,
            "statusMessage": "Checking goal loop"
          }
        ]
      }
    ]
  }
}
