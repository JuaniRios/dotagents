{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "clean_reason", "reviewer_error"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "category",
          "file",
          "line_start",
          "line_end",
          "finding",
          "why_it_matters",
          "recommended_fix",
          "confidence"
        ],
        "properties": {
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "nit"]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "convention",
              "maintainability",
              "tests",
              "consistency",
              "goal",
              "completeness",
              "feasibility",
              "scope",
              "cost",
              "approach"
            ]
          },
          "file": { "type": ["string", "null"] },
          "line_start": { "type": ["integer", "null"] },
          "line_end": { "type": ["integer", "null"] },
          "finding": { "type": "string" },
          "why_it_matters": { "type": "string" },
          "recommended_fix": { "type": "string" },
          "confidence": { "type": "integer" }
        }
      }
    },
    "clean_reason": { "type": "string" },
    "reviewer_error": { "type": "string" }
  }
}
